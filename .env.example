# Where the Next.js server reaches the API. The browser always calls /api/v1 on
# this app's own origin, and Next forwards it here.
API_ORIGIN=http://localhost:4100

# Same value as EDGE_PROXY_SECRET on the API. Lets the API trust the client
# address this server forwards. Generate with: openssl rand -base64 48
EDGE_PROXY_SECRET=
